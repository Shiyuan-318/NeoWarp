[Desktop Entry]
Name=NeoWarp
# Change the path to match where you install the app.
Exec=/opt/NeoWarp/neowarp %U
Terminal=false
Type=Application
Icon=org.neowarp.NeoWarp
StartupWMClass=neowarp
Comment=NeoWarp is a Scratch mod with a compiler to run projects faster, dark mode for your eyes, a bunch of addons to improve the editor, and more.
MimeType=application/x.scratch.sb3;application/x.scratch.sb2;application/x.scratch.sb;application/x.scratch.np1;application/x.neowarp.npnp;application/x.neowarp.viewsb3;
Categories=Development;
Keywords=scratch;
