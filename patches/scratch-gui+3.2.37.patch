+
+/* NeoWarp: in full screen the overlay no longer covers the app menu bar.
+   It becomes a transparent, click-through layer below the menu bar and the
+   controls float as a vertical column at the top-left of the stage.
+   These rules must come after the base rules above to win the cascade. */
+.below-menu-bar {
+    /* --neowarp-fullscreen-top: real stage offset from the viewport top,
+       published by the desktop app (menu bar height normally; title bar
+       height when the menu bar is hidden in full screen) */
+    top: var(--neowarp-fullscreen-top, $menu-bar-height);
+    background-color: transparent;
+    pointer-events: none;
+}
+
+/* The anchor keeps the stage's width (inline style + margin: auto) so it
+   lines up with the stage below; it collapses to 0 height and its children
+   hang as a vertical column in the margin left of the stage. */
+.vertical-anchor {
+    flex-direction: column;
+    align-items: flex-start;
+    justify-content: flex-start;
+    row-gap: 0.25rem;
+    height: 0;
+    padding: 0;
+    overflow: visible;
+}
+
+/* Controls (green flag / pause / stop) as the top of the column.
+   translateX(-100% - 0.5rem) anchors each child's RIGHT edge 0.5rem left of
+   the stage's left edge, so the column also grows leftwards (e.g. when the
+   turbo/FPS badges widen it) instead of overlapping the stage. */
+.vertical-controls {
+    flex-direction: column;
+    align-items: center;
+    gap: 0.25rem;
+    transform: translateX(calc(-100% - 0.5rem));
+    pointer-events: auto;
+}
