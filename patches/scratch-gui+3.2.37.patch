+/**
+ * NeoWarp: keep the menu mounted for a short moment after `open` turns false
+ * so the fade/out CSS animation can play. CLOSE_DELAY_MS must be >= the
+ * duration of the `menu-out` keyframes in components/menu/menu.css.
+ */
+const CLOSE_DELAY_MS = 200;
+
+class Menu extends React.PureComponent {
+    constructor (props) {
+        super(props);
+        this.state = {
+            render: props.open || false,
+            closing: false,
+            // bumped to remount the <ul> and replay the enter animation when
+            // reopening a menu that was still animating out
+            openCount: 0
+        };
+        bindAll(this, ['finishClose']);
+        this.closeTimeout = null;
+    }
+    componentDidUpdate (prevProps) {
+        if (this.props.open === prevProps.open) return;
+        if (this.props.open) {
+            // opened (maybe interrupting a closing animation)
+            if (this.closeTimeout) {
+                clearTimeout(this.closeTimeout);
+                this.closeTimeout = null;
+            }
+            if (!this.state.render) {
+                // eslint-disable-next-line react/no-did-update-set-state
+                this.setState({render: true, closing: false});
+            } else if (this.state.closing) {
+                // eslint-disable-next-line react/no-did-update-set-state
+                this.setState({
+                    closing: false,
+                    openCount: this.state.openCount + 1
+                });
+            }
+        } else if (this.state.render && !this.state.closing) {
+            // begin closing: stay mounted while the exit animation plays
+            this.setState({closing: true}, () => {
+                this.closeTimeout = setTimeout(this.finishClose, CLOSE_DELAY_MS);
+            });
+        }
+    }
+    componentWillUnmount () {
+        if (this.closeTimeout) {
+            clearTimeout(this.closeTimeout);
+            this.closeTimeout = null;
+        }
+    }
+    finishClose () {
+        this.closeTimeout = null;
+        this.setState({render: false, closing: false});
+    }
+    render () {
+        if (!this.state.render) return null;
+        const {open, children, ...passThrough} = this.props;
+        return (
+            <MenuComponent
+                {...passThrough}
+                key={this.state.openCount}
+                className={this.state.closing ? menuStyles.closing : undefined}
+            >
+                {children}
+            </MenuComponent>
+        );
+    }
+}
 
