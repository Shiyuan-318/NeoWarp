+class DoubleArrowMode extends React.Component {
+    constructor (props) {
+        super(props);
+        bindAll(this, [
+            'activateTool',
+            'deactivateTool',
+            'validateColorState'
+        ]);
+    }
+    componentDidMount () {
+        if (this.props.isDoubleArrowModeActive) {
+            this.activateTool(this.props);
+        }
+    }
+    componentWillReceiveProps (nextProps) {
+        if (this.tool && nextProps.colorState !== this.props.colorState) {
+            this.tool.setColorState(nextProps.colorState);
+        }
+        if (this.tool && nextProps.selectedItems !== this.props.selectedItems) {
+            this.tool.onSelectionChanged(nextProps.selectedItems);
+        }
+
+        if (nextProps.isDoubleArrowModeActive && !this.props.isDoubleArrowModeActive) {
+            this.activateTool();
+        } else if (!nextProps.isDoubleArrowModeActive && this.props.isDoubleArrowModeActive) {
+            this.deactivateTool();
+        }
+    }
+    shouldComponentUpdate (nextProps) {
+        return nextProps.isDoubleArrowModeActive !== this.props.isDoubleArrowModeActive;
