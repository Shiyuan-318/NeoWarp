 }
 
 .menu.left {
     right: 0;
+
+    /* menus placed on the right side of the trigger (RTL layout) reveal from their right edge */
+    transform-origin: top right;
 }
 
 .menu.right {
     left: 0;
 }
 
+/* NeoWarp: keep the menu mounted while it fades/shrinks out; ignore clicks meanwhile.
+   Duration must stay <= CLOSE_DELAY_MS in containers/menu.jsx */
+.menu.closing {
