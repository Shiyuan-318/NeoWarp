+        this.arrow.add(new paper.Point(shaftRight, shaftTop));
+        this.arrow.add(new paper.Point(shaftRight, y1));
+        this.arrow.add(new paper.Point(x2, midY));
+        this.arrow.add(new paper.Point(shaftRight, y2));
+        this.arrow.add(new paper.Point(shaftRight, shaftBottom));
+        this.arrow.add(new paper.Point(x1, shaftBottom));
+        this.arrow.closed = true;
+
+        if (event.modifiers.alt) {
+            this.arrow.position = event.downPoint;
+        } else if (event.modifiers.shift) {
