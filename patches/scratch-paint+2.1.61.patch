+import React from 'react';
+import PropTypes from 'prop-types';
+
+import Input from './forms/input.jsx';
+import InputGroup from './input-group/input-group.jsx';
+import Label from './forms/label.jsx';
+import LiveInputHOC from './forms/live-input-hoc.jsx';
+
+import {MAX_CORNER_RADIUS, MAX_CORNER_CURVATURE} from '../reducers/rounded-rect';
+
+const LiveInput = LiveInputHOC(Input);
+
+const CornerSettingsIndicatorComponent = props => (
+    <React.Fragment>
+        <InputGroup disabled={props.disabled}>
+            <Label text={props.radiusLabel}>
+                <LiveInput
+                    range
+                    small
+                    disabled={props.disabled}
+                    max={MAX_CORNER_RADIUS}
+                    min="0"
+                    type="number"
+                    value={props.cornerRadius ? props.cornerRadius : 0}
+                    onSubmit={props.onChangeCornerRadius}
+                />
+            </Label>
+        </InputGroup>
+        <InputGroup disabled={props.disabled}>
+            <Label text={props.curvatureLabel}>
+                <LiveInput
+                    range
+                    small
+                    disabled={props.disabled}
+                    max={MAX_CORNER_CURVATURE}
+                    min="0"
+                    type="number"
+                    value={props.cornerCurvature !== null && props.cornerCurvature !== undefined ?
+                        props.cornerCurvature : MAX_CORNER_CURVATURE}
+                    onSubmit={props.onChangeCornerCurvature}
+                />
+            </Label>
+        </InputGroup>
+    </React.Fragment>
+);
+
+CornerSettingsIndicatorComponent.propTypes = {
+    cornerCurvature: PropTypes.number,
+    cornerRadius: PropTypes.number,
+    curvatureLabel: PropTypes.string.isRequired,
+    disabled: PropTypes.bool.isRequired,
+    onChangeCornerCurvature: PropTypes.func.isRequired,
+    onChangeCornerRadius: PropTypes.func.isRequired,
+    radiusLabel: PropTypes.string.isRequired
+};
+
+export default CornerSettingsIndicatorComponent;
