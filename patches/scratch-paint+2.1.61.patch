new file mode 100644
index 0000000..cb93ffd
--- /dev/null
+++ b/node_modules/scratch-paint/src/reducers/rounded-rect.js
@@ -0,0 +1,67 @@
+import log from '../log/log';
+
+const CHANGE_CORNER_RADIUS = 'scratch-paint/rounded-rect/CHANGE_CORNER_RADIUS';
+const CHANGE_CORNER_CURVATURE = 'scratch-paint/rounded-rect/CHANGE_CORNER_CURVATURE';
+
+const MAX_CORNER_RADIUS = 200;
+const MAX_CORNER_CURVATURE = 100;
+const DEFAULT_CORNER_RADIUS = 20;
+const DEFAULT_CORNER_CURVATURE = 100;
+
+const initialState = {
+    cornerRadius: DEFAULT_CORNER_RADIUS,
+    cornerCurvature: DEFAULT_CORNER_CURVATURE
+};
+
+const reducer = function (state, action) {
+    if (typeof state === 'undefined') state = initialState;
+    switch (action.type) {
+    case CHANGE_CORNER_RADIUS:
+        if (isNaN(action.cornerRadius)) {
+            log.warn(`Invalid corner radius: ${action.cornerRadius}`);
+            return state;
+        }
+        return {
+            ...state,
+            cornerRadius: Math.min(MAX_CORNER_RADIUS, Math.max(0, action.cornerRadius))
+        };
+    case CHANGE_CORNER_CURVATURE:
+        if (isNaN(action.cornerCurvature)) {
+            log.warn(`Invalid corner curvature: ${action.cornerCurvature}`);
+            return state;
+        }
+        return {
+            ...state,
+            cornerCurvature: Math.min(MAX_CORNER_CURVATURE, Math.max(0, action.cornerCurvature))
+        };
+    default:
+        return state;
+    }
+};
+
+// Action creators
+const changeCornerRadius = function (cornerRadius) {
+    return {
+        type: CHANGE_CORNER_RADIUS,
+        cornerRadius: cornerRadius
+    };
+};
+
+const changeCornerCurvature = function (cornerCurvature) {
+    return {
+        type: CHANGE_CORNER_CURVATURE,
+        cornerCurvature: cornerCurvature
+    };
+};
+
+export {
+    reducer as default,
+    changeCornerRadius,
+    changeCornerCurvature,
+    CHANGE_CORNER_RADIUS,
+    CHANGE_CORNER_CURVATURE,
+    MAX_CORNER_RADIUS,
+    MAX_CORNER_CURVATURE,
+    DEFAULT_CORNER_RADIUS,
+    DEFAULT_CORNER_CURVATURE
+};
