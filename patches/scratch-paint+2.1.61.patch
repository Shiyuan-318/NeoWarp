+            this.props.onChangeStrokeColor(null);
+            this.props.clearStrokeGradient();
+        } else if (fillColorMissing && !strokeColorMissing) {
+            this.props.onChangeFillColor(null);
+            this.props.clearFillGradient();
+        } else if (!fillColorMissing && strokeColorMissing) {
