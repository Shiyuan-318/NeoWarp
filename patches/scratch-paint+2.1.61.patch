+import PropTypes from 'prop-types';
+import React from 'react';
+import {connect} from 'react-redux';
+import {defineMessages, injectIntl, intlShape} from 'react-intl';
+import bindAll from 'lodash.bindall';
+
+import {changeCornerRadius, changeCornerCurvature} from '../reducers/rounded-rect';
+import {setSelectedItems} from '../reducers/selected-items';
+import CornerSettingsIndicatorComponent from '../components/corner-settings-indicator.jsx';
+import Modes from '../lib/modes';
+import {getSelectedLeafItems} from '../helper/selection';
+import {
+    isRoundedRectPath,
+    getRoundedRectParams,
+    rebuildRoundedRectPath
+} from '../helper/tools/rounded-rect-tool';
+
+const messages = defineMessages({
+    radius: {
+        defaultMessage: '半径',
+        description: 'Label for the corner radius input',
+        id: 'paint.cornerSettings.radius'
+    },
+    curvature: {
+        defaultMessage: '曲率',
+        description: 'Label for the corner curvature input',
+        id: 'paint.cornerSettings.curvature'
+    }
+});
+
+/**
+ * Find the first selected rounded-rect item from an array of paper items.
+ * @param {Array<paper.Item>} selectedItems
+ * @returns {paper.Item|null}
+ */
+const findSelectedRoundedRect = selectedItems => {
+    if (!selectedItems) return null;
+    for (const item of selectedItems) {
+        if (isRoundedRectPath(item)) return item;
+    }
+    return null;
+};
+
+class CornerSettingsIndicator extends React.Component {
+    constructor (props) {
+        super(props);
+        bindAll(this, [
+            'handleChangeCornerRadius',
+            'handleChangeCornerCurvature'
+        ]);
+    }
+    handleChangeCornerRadius (radius) {
+        if (this.props.mode === Modes.ROUNDED_RECT) {
+            // Drawing mode: update the default for the next shape
+            this.props.onChangeCornerRadius(radius);
+            return;
+        }
+        // Selection mode: rebuild the selected rounded rectangle
+        const selectedRect = findSelectedRoundedRect(getSelectedLeafItems());
+        if (selectedRect) {
+            const oldCurvature = getRoundedRectParams(selectedRect).cornerCurvature;
+            rebuildRoundedRectPath(selectedRect, radius, oldCurvature);
+            this.props.setSelectedItems();
+            this.props.onUpdateImage();
+        }
+    }
+    handleChangeCornerCurvature (curvature) {
+        if (this.props.mode === Modes.ROUNDED_RECT) {
+            // Drawing mode: update the default for the next shape
+            this.props.onChangeCornerCurvature(curvature);
+            return;
+        }
+        // Selection mode: rebuild the selected rounded rectangle
+        const selectedRect = findSelectedRoundedRect(getSelectedLeafItems());
+        if (selectedRect) {
+            const oldRadius = getRoundedRectParams(selectedRect).cornerRadius;
+            rebuildRoundedRectPath(selectedRect, oldRadius, curvature);
+            this.props.setSelectedItems();
+            this.props.onUpdateImage();
+        }
+    }
+    render () {
+        if (!this.props.visible) return null;
+        return (
+            <CornerSettingsIndicatorComponent
+                cornerRadius={this.props.cornerRadius}
+                cornerCurvature={this.props.cornerCurvature}
+                curvatureLabel={this.props.intl.formatMessage(messages.curvature)}
+                disabled={this.props.disabled}
+                onChangeCornerRadius={this.handleChangeCornerRadius}
+                onChangeCornerCurvature={this.handleChangeCornerCurvature}
+                radiusLabel={this.props.intl.formatMessage(messages.radius)}
+            />
+        );
+    }
+}
+
+CornerSettingsIndicator.propTypes = {
+    cornerCurvature: PropTypes.number,
+    cornerRadius: PropTypes.number,
+    disabled: PropTypes.bool.isRequired,
+    intl: intlShape.isRequired,
+    mode: PropTypes.string,
+    onChangeCornerCurvature: PropTypes.func.isRequired,
+    onChangeCornerRadius: PropTypes.func.isRequired,
+    onUpdateImage: PropTypes.func.isRequired,
+    setSelectedItems: PropTypes.func.isRequired,
+    visible: PropTypes.bool.isRequired
+};
+
+const mapStateToProps = state => {
+    const isDrawingMode = state.scratchPaint.mode === Modes.ROUNDED_RECT;
+    // Only consider selection-based editing when not in drawing mode
+    const selectedRoundedRect = isDrawingMode ? null :
+        findSelectedRoundedRect(state.scratchPaint.selectedItems);
+    const visible = isDrawingMode || !!selectedRoundedRect;
+
+    let cornerRadius;
+    let cornerCurvature;
+    if (selectedRoundedRect) {
+        const params = getRoundedRectParams(selectedRoundedRect);
+        cornerRadius = params.cornerRadius;
+        cornerCurvature = params.cornerCurvature;
+    } else {
+        cornerRadius = state.scratchPaint.roundedRect.cornerRadius;
+        cornerCurvature = state.scratchPaint.roundedRect.cornerCurvature;
+    }
+
+    return {
+        cornerRadius,
+        cornerCurvature,
+        disabled: !visible,
+        mode: state.scratchPaint.mode,
+        selectedRoundedRect,
+        visible
+    };
+};
+
+const mapDispatchToProps = dispatch => ({
+    onChangeCornerRadius: cornerRadius => {
+        dispatch(changeCornerRadius(cornerRadius));
+    },
+    onChangeCornerCurvature: cornerCurvature => {
+        dispatch(changeCornerCurvature(cornerCurvature));
+    },
+    setSelectedItems: () => {
+        dispatch(setSelectedItems(getSelectedLeafItems(), false /* bitmapMode */));
+    }
+});
+
+export default connect(
+    mapStateToProps,
+    mapDispatchToProps
+)(injectIntl(CornerSettingsIndicator));
