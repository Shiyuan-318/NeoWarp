+    animation: menu-out 0.16s cubic-bezier(0.32, 0.72, 0, 1) both;
+}
+
+/* NeoWarp */
+@keyframes menu-in {
+    from {
+        opacity: 0;
+        transform: translateY(8px) scale(0.96);
+    }
+    to {
+        opacity: 1;
+        transform: translateY(0) scale(1);
+    }
+}
+
+/* NeoWarp */
+@keyframes menu-out {
+    from {
+        opacity: 1;
+        transform: translateY(0) scale(1);
+    }
+    to {
+        opacity: 0;
+        transform: translateY(8px) scale(0.96);
+    }
+}
+
